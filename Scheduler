import java.util.ArrayList;
import java.util.List;

public class Scheduler {

```
private static final int TIME_QUANTUM = 5;

private String ganttChart = "";
private ArrayList<PCB> readyQueue;
private int currentTime = 0;

public Scheduler(ArrayList<PCB> readyQueue) {
    this.readyQueue = readyQueue;
}

public String getGanttChart() {
    return ganttChart;
}

public void startSJF() {
    ganttChart = "";
    currentTime = 0;

    ArrayList<PCB> local = new ArrayList<>(readyQueue);
    ArrayList<PCB> completed = new ArrayList<>();

    for (PCB p : local) resetProcess(p);

    System.out.println("\n[Time " + currentTime + "ms] === SJF Scheduling Started ===");

    while (!local.isEmpty()) {
        PCB current = selectShortest(local);
        local.remove(current);

        if (current.startTime == -1)
            current.startTime = currentTime;

        current.state = "RUNNING";
        ganttChart += currentTime + " [P" + current.pid + "] ";

        System.out.println("[Time " + currentTime + "ms] Process P" + current.pid +
                " executing for " + current.burstTime + "ms");

        currentTime += current.burstTime;

        terminateJob(current, currentTime);
        completed.add(current);

        System.out.println("[Time " + currentTime + "ms] Process P" + current.pid + " finished.");
    }

    ganttChart += currentTime;
    System.out.println("[Time " + currentTime + "ms] === SJF Scheduling Completed ===");

    printGanttChart(completed);
    printTable(completed);
    printMetrics(completed);
}

public void startRoundRobin() {
    ganttChart = "";
    currentTime = 0;

    ArrayList<PCB> local = new ArrayList<>(readyQueue);
    ArrayList<PCB> completed = new ArrayList<>();

    for (PCB p : local) resetProcess(p);

    System.out.println("\n[Time " + currentTime + "ms] === Round Robin Scheduling Started (Quantum: " + TIME_QUANTUM + "ms) ===");

    while (!local.isEmpty()) {
        PCB current = local.remove(0);

        if (current.startTime == -1)
            current.startTime = currentTime;

        current.state = "RUNNING";
        int slice = Math.min(TIME_QUANTUM, current.remainingTime);

        ganttChart += currentTime + " [P" + current.pid + "] ";

        System.out.println("[Time " + currentTime + "ms] Process P" + current.pid +
                " executing for " + slice + "ms");

        currentTime += slice;
        current.remainingTime -= slice;

        if (current.remainingTime == 0) {
            terminateJob(current, currentTime);
            completed.add(current);
            System.out.println("[Time " + currentTime + "ms] Process P" + current.pid + " finished.");
        } else {
            current.state = "READY";
            local.add(current);
        }
    }

    ganttChart += currentTime;
    System.out.println("[Time " + currentTime + "ms] === Round Robin Scheduling Completed ===");

    printGanttChart(completed);
    printTable(completed);
    printMetrics(completed);
}

private static PCB selectShortest(List<PCB> ready) {
    PCB pcb = ready.get(0);
    for (int i = 1; i < ready.size(); i++) {
        PCB p = ready.get(i);
        if (p.burstTime < pcb.burstTime ||
            (p.burstTime == pcb.burstTime && p.pid < pcb.pid)) {
            pcb = p;
        }
    }
    return pcb;
}

private void terminateJob(PCB job, int time) {
    job.state = "TERMINATED";
    job.finishTime = time;
    job.turnaroundTime = job.finishTime;
    job.waitingTime = job.turnaroundTime - job.burstTime;
}

private void resetProcess(PCB p) {
    p.remainingTime  = p.burstTime;
    p.startTime      = -1;
    p.finishTime     = -1;
    p.waitingTime    = 0;
    p.turnaroundTime = 0;
    p.state          = "READY";
}

private void printGanttChart(List<PCB> completed) {
    System.out.println("\n── Gantt Chart ──────────────────────────────────────────────");
    System.out.println(ganttChart);
    System.out.println();
    for (PCB p : completed) {
        System.out.printf("  P%-3d  [%4d ms - %4d ms]%n", p.pid, p.startTime, p.finishTime);
    }
}

private void printTable(List<PCB> completed) {
    System.out.println("\n── Process Table ────────────────────────────────────────────");
    System.out.printf("%-6s %-12s %-12s %-16s %-14s %-16s%n",
            "PID", "Burst(ms)", "Start(ms)", "Terminate(ms)", "Waiting(ms)", "Turnaround(ms)");
    System.out.println("-".repeat(78));
    for (PCB p : completed) {
        System.out.printf("%-6d %-12d %-12d %-16d %-14d %-16d%n",
                p.pid, p.burstTime, p.startTime, p.finishTime, p.waitingTime, p.turnaroundTime);
    }
}

private void printMetrics(List<PCB> completed) {
    double avgTAT = completed.stream().mapToInt(p -> p.turnaroundTime).average().orElse(0);
    double avgWT  = completed.stream().mapToInt(p -> p.waitingTime).average().orElse(0);

    System.out.println("\n── Performance Metrics ──────────────────────────────────────");
    System.out.printf("  Average Turnaround Time : %.2f ms%n", avgTAT);
    System.out.printf("  Average Waiting Time    : %.2f ms%n", avgWT);
    System.out.println("=".repeat(60));
}
